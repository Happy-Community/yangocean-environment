            --muted: #66756b;
            --border: #dce7da;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.8;
            color: var(--text);
            background-color: var(--cream);
            margin: 0;
        }

        a {
