<footer>
    <p>&copy; <span id="currentYear"></span> Yangocean. Vivre en pleine conscience, connexion avec la nature et durabilité.</p>
</footer>

<script>
(function () {
    "use strict";

    const readButton = document.getElementById("readAloud");
    const pauseButton = document.getElementById("pauseResume");
    const stopButton = document.getElementById("stopReading");
    const status = document.getElementById("readingStatus");
    const article = document.getElementById("articleContent");

    let utterance = null;
    let reading = false;

    function setIdle(message) {
        reading = false;
        utterance = null;
        readButton.disabled = false;
        pauseButton.disabled = true;
        stopButton.disabled = true;
        pauseButton.textContent = "⏸ Pause";
        status.textContent = message;
    }

    function stopSpeech(message) {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
        }

        setIdle(message || "Lecture arrêtée.");
    }

    function getArticleText() {
        const clone = article.cloneNode(true);

        clone.querySelectorAll(
            ".article-controls, script, style, nav, button"
        ).forEach(function (element) {
            element.remove();
        });

        return clone.innerText
            .replace(/\s+/g, " ")
            .trim();
    }

    if (!("speechSynthesis" in window) ||
        !("SpeechSynthesisUtterance" in window)) {
        readButton.disabled = true;
        pauseButton.disabled = true;
        stopButton.disabled = true;
        status.textContent =
            "Désolé, la lecture audio n'est pas prise en charge par ce navigateur. Veuillez essayer un autre navigateur ou appareil.";
    } else {
        readButton.addEventListener("click", function () {
            stopSpeech("Préparation de l'article pour la lecture…");

            const text = getArticleText();

            if (!text) {
                setIdle("Le texte de l'article est introuvable.");
                return;
            }

            utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = "fr-FR";
            utterance.rate = 0.95;
            utterance.pitch = 1;

            utterance.onstart = function () {
                reading = true;
                readButton.disabled = true;
                pauseButton.disabled = false;
                stopButton.disabled = false;
                status.textContent = "Lecture de l'article en cours…";
            };

            utterance.onend = function () {
                setIdle("La lecture de l'article est terminée.");
            };

            utterance.onerror = function (event) {
                if (event.error === "canceled" ||
                    event.error === "interrupted") {
                    setIdle("Lecture arrêtée.");
                } else {
                    setIdle("La lecture n'a pas pu continuer. Veuillez réessayer.");
                }
            };

            try {
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(utterance);
                readButton.disabled = true;
                pauseButton.disabled = false;
                stopButton.disabled = false;
                status.textContent = "Démarrage de la lecture audio…";
            } catch (error) {
                setIdle("Impossible de démarrer la lecture audio. Veuillez réessayer.");
            }
        });

        pauseButton.addEventListener("click", function () {
            if (!reading) {
                return;
            }

            if (window.speechSynthesis.paused) {
                window.speechSynthesis.resume();
                pauseButton.textContent = "⏸ Pause";
                status.textContent = "Lecture reprise…";
            } else {
                window.speechSynthesis.pause();
                pauseButton.textContent = "▶ Reprendre";
                status.textContent = "Lecture en pause.";
            }
        });

        stopButton.addEventListener("click", function () {
            stopSpeech("Lecture arrêtée.");
        });
    }

    document.getElementById("copyArticleLink").addEventListener(
        "click",
        async function () {
            const articleUrl =
                "https://www.yangocean.com/fr/blog/meditation-for-retirees.html";

            const message = document.getElementById("copyMessage");

            try {
                await navigator.clipboard.writeText(articleUrl);
                message.textContent = "Le lien de l'article a été copié.";
            } catch (error) {
                message.textContent =
                    "La copie automatique n'est pas disponible. Veuillez copier ce lien : " +
                    articleUrl;
            }
        }
    );

    document.getElementById("currentYear").textContent =
        new Date().getFullYear();

    window.addEventListener("pagehide", function () {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
        }
    });
})();
</script>

</body>
</html>
