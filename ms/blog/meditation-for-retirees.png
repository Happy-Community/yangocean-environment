<footer>
    <p>&copy; <span id="currentYear"></span> Yangocean. Kehidupan berkesedaran, hubungan dengan alam semula jadi dan kelestarian.</p>
</footer>

<script>
(function () {
    "use strict";

    const readButton = document.getElementById("readAloud");
    const pauseButton = document.getElementById("pauseResume");
    const stopButton = document.getElementById("stopReading");
    const status = document.getElementById("readingStatus");
    const article = document.getElementById("articleContent");

    let utterance = null;
    let reading = false;

    function setIdle(message) {
        reading = false;
        utterance = null;
        readButton.disabled = false;
        pauseButton.disabled = true;
        stopButton.disabled = true;
        pauseButton.textContent = "⏸ Jeda";
        status.textContent = message;
    }

    function stopSpeech(message) {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
        }

        setIdle(message || "Bacaan dihentikan.");
    }

    function getArticleText() {
        const clone = article.cloneNode(true);

        clone.querySelectorAll(
            ".article-controls, script, style, nav, button"
        ).forEach(function (element) {
            element.remove();
        });

        return clone.innerText
            .replace(/\s+/g, " ")
            .trim();
    }

    if (!("speechSynthesis" in window) ||
        !("SpeechSynthesisUtterance" in window)) {
        readButton.disabled = true;
        pauseButton.disabled = true;
        stopButton.disabled = true;
        status.textContent =
            "Maaf, fungsi bacaan audio tidak disokong oleh pelayar ini. Sila cuba pelayar atau peranti yang lain.";
    } else {
        readButton.addEventListener("click", function () {
            stopSpeech("Menyediakan artikel untuk dibacakan…");

            const text = getArticleText();

            if (!text) {
                setIdle("Teks artikel tidak dapat ditemui.");
                return;
            }

            utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = "ms-MY";
            utterance.rate = 0.95;
            utterance.pitch = 1;

            utterance.onstart = function () {
                reading = true;
                readButton.disabled = true;
                pauseButton.disabled = false;
                stopButton.disabled = false;
                status.textContent = "Artikel sedang dibacakan…";
            };

            utterance.onend = function () {
                setIdle("Bacaan artikel telah selesai.");
            };

            utterance.onerror = function (event) {
                if (event.error === "canceled" ||
                    event.error === "interrupted") {
                    setIdle("Bacaan dihentikan.");
                } else {
                    setIdle("Bacaan tidak dapat diteruskan. Sila cuba lagi.");
                }
            };

            try {
                window.speechSynthesis.cancel();
                window.speechSynthesis.speak(utterance);
                readButton.disabled = true;
                pauseButton.disabled = false;
                stopButton.disabled = false;
                status.textContent = "Memulakan bacaan audio…";
            } catch (error) {
                setIdle("Tidak dapat memulakan bacaan audio. Sila cuba lagi.");
            }
        });

        pauseButton.addEventListener("click", function () {
            if (!reading) {
                return;
            }

            if (window.speechSynthesis.paused) {
                window.speechSynthesis.resume();
                pauseButton.textContent = "⏸ Jeda";
                status.textContent = "Bacaan disambung semula…";
            } else {
                window.speechSynthesis.pause();
                pauseButton.textContent = "▶ Sambung";
                status.textContent = "Bacaan dijeda.";
            }
        });

        stopButton.addEventListener("click", function () {
            stopSpeech("Bacaan dihentikan.");
        });
    }

    document.getElementById("copyArticleLink").addEventListener(
        "click",
        async function () {
            const articleUrl =
                "https://www.yangocean.com/ms/blog/meditation-for-retirees.html";

            const message = document.getElementById("copyMessage");

            try {
                await navigator.clipboard.writeText(articleUrl);
                message.textContent = "Pautan artikel telah disalin.";
            } catch (error) {
                message.textContent =
                    "Penyalinan automatik tidak tersedia. Sila salin pautan ini: " +
                    articleUrl;
            }
        }
    );

    document.getElementById("currentYear").textContent =
        new Date().getFullYear();

    window.addEventListener("pagehide", function () {
        if ("speechSynthesis" in window) {
            window.speechSynthesis.cancel();
        }
    });
})();
</script>

</body>
</html>
