<script>

// Update copyright year
document.getElementById("year").textContent =
    new Date().getFullYear();


// Read Aloud functionality

let speechUtterance = null;

function getArticleText() {

    const article = document.getElementById("article-content");

    const clone = article.cloneNode(true);

    // Remove controls and sharing buttons from spoken content
    const elementsToRemove = clone.querySelectorAll(
        ".read-aloud, .share, .back-link"
    );

    elementsToRemove.forEach(element => element.remove());

    return clone.innerText.trim();
}


function updateAudioButtons(isSpeaking) {

    document.getElementById("readButton").disabled = isSpeaking;

    document.getElementById("pauseButton").disabled = !isSpeaking;

    document.getElementById("resumeButton").disabled = true;

    document.getElementById("stopButton").disabled = !isSpeaking;
}


function startReading() {

    if (!("speechSynthesis" in window)) {

        document.getElementById("audioStatus").textContent =
            "Lo sentimos, su navegador no admite la lectura en voz alta.";

        return;
    }

    window.speechSynthesis.cancel();

    const textToRead = getArticleText();

    speechUtterance = new SpeechSynthesisUtterance(textToRead);

    // Spanish voice and language
    speechUtterance.lang = "es-ES";

    speechUtterance.rate = 0.9;

    speechUtterance.pitch = 1;

    speechUtterance.volume = 1;


    // Prefer a Spanish voice when available
    const voices = window.speechSynthesis.getVoices();

    const spanishVoice = voices.find(voice =>
        voice.lang.toLowerCase().startsWith("es-es")
    ) || voices.find(voice =>
        voice.lang.toLowerCase().startsWith("es")
    );

    if (spanishVoice) {
        speechUtterance.voice = spanishVoice;
    }


    speechUtterance.onstart = function() {

        updateAudioButtons(true);

        document.getElementById("audioStatus").textContent =
            "Leyendo el artículo...";
    };


    speechUtterance.onend = function() {

        updateAudioButtons(false);

        document.getElementById("audioStatus").textContent =
            "La lectura ha finalizado.";

        speechUtterance = null;
    };


    speechUtterance.onerror = function() {

        updateAudioButtons(false);

        document.getElementById("audioStatus").textContent =
            "No se pudo completar la lectura. Inténtelo de nuevo.";

        speechUtterance = null;
    };


    window.speechSynthesis.speak(speechUtterance);
}


function pauseReading() {

    if (window.speechSynthesis.speaking &&
        !window.speechSynthesis.paused) {

        window.speechSynthesis.pause();

        document.getElementById("pauseButton").disabled = true;

        document.getElementById("resumeButton").disabled = false;

        document.getElementById("audioStatus").textContent =
            "Lectura pausada.";
    }
}


function resumeReading() {

    if (window.speechSynthesis.paused) {

        window.speechSynthesis.resume();

        document.getElementById("pauseButton").disabled = false;

        document.getElementById("resumeButton").disabled = true;

        document.getElementById("audioStatus").textContent =
            "Reanudando la lectura...";
    }
}


function stopReading() {

    if ("speechSynthesis" in window) {

        window.speechSynthesis.cancel();
    }

    speechUtterance = null;

    updateAudioButtons(false);

    document.getElementById("audioStatus").textContent =
        "Lectura detenida.";
}


// Copy article link

function copyArticleLink() {

    const articleUrl =
        "https://www.yangocean.com/es/blog/meditation-for-retirees.html";

    if (navigator.clipboard && window.isSecureContext) {

        navigator.clipboard.writeText(articleUrl)
            .then(() => {
                alert("¡Enlace copiado!");
            })
            .catch(() => {
                fallbackCopy(articleUrl);
            });

    } else {

        fallbackCopy(articleUrl);
    }
}


function fallbackCopy(text) {

    const textArea = document.createElement("textarea");

    textArea.value = text;

    textArea.style.position = "fixed";

    textArea.style.opacity = "0";

    document.body.appendChild(textArea);

    textArea.select();

    try {

        document.execCommand("copy");

        alert("¡Enlace copiado!");

    } catch (error) {

        alert("No se pudo copiar el enlace. Puede copiarlo desde la barra de direcciones.");
    }

    document.body.removeChild(textArea);
}


// Stop speech when leaving the page

window.addEventListener("pagehide", function() {

    if ("speechSynthesis" in window) {

        window.speechSynthesis.cancel();
    }

});

</script>

</body>
</html>
